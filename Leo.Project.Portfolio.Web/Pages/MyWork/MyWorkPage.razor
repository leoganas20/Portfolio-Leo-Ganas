@using Leo.Project.Portfolio.Web.Pages.MyWork.Model;


<section id="my-work" class="my-work" style="background-color: var(--gh-bg); border-top: 1px solid var(--gh-border); padding: 80px 0;">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">// featured work</span>
            <h2 class="section-title">Projects &amp; accomplishments</h2>
            <p class="section-sub">Production systems I've built and maintained for government agencies and private-sector teams.</p>
        </div>
        <div class="current-work-card">
            <div class="current-work-top">
                <span class="current-badge"><span class="current-dot"></span>Current &middot; Dec 2025 &ndash; Present</span>
                <span class="current-companies">KVLR Code &amp; Born Digital &middot; Malta (Remote)</span>
            </div>

            <h3 class="current-title">Licensing Platform Modernization</h3>
            <p class="current-lead">
                Maintaining and refactoring a large, long-running legacy ASP.NET Core and C# codebase for a licensing
                platform, working across two engineering teams in Malta. Modernizing existing modules step by step while
                production keeps running and new features keep shipping.
            </p>

            <div class="current-highlights">
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="current-highlight-icon" />
                    <h4>Legacy code refactoring</h4>
                    <p>Untangling long-standing modules and reducing technical debt without changing production behavior.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Api" Class="current-highlight-icon" />
                    <h4>API &amp; data layer</h4>
                    <p>Maintaining ASP.NET Core Web APIs and the Entity Framework / SQL Server data layer.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Class="current-highlight-icon" />
                    <h4>Distributed teams</h4>
                    <p>Collaborating remotely across two companies working toward one platform.</p>
                </div>
            </div>

            <div class="current-stack">
                <span>C#</span><span>ASP.NET Core</span><span>Web API</span><span>Entity Framework</span><span>SQL Server</span><span>Legacy modernization</span>
            </div>
        </div>

        <div class="current-work-card project-text-card">
            <div class="current-work-top">
                <span class="current-badge is-past">Jun 2023 &ndash; Dec 2025</span>
                <span class="current-companies">Blackfort PH &middot; Responsive web app &amp; native mobile app</span>
            </div>

            <h3 class="current-title">Infrastructure Monitoring &amp; Inspection Platform</h3>
            <p class="current-lead">
                Developed infrastructure monitoring and inspection systems that capture real-time field data &mdash; photos,
                GPS geolocation and offline support &mdash; with seamless integration between the mobile app and the web platform.
            </p>

            <div class="current-highlights">
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Web" Class="current-highlight-icon" />
                    <h4>Web dashboards</h4>
                    <p>Dashboards for infrastructure management that let administrators monitor inspection data, track site locations and generate reports.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Smartphone" Class="current-highlight-icon" />
                    <h4>Mobile field app</h4>
                    <p>Site-inspection app that lets field agents capture geolocated photos and data offline.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Class="current-highlight-icon" />
                    <h4>Offline-first sync</h4>
                    <p>Data captured offline is synced to the server automatically once the device is back online.</p>
                </div>
            </div>

            <div class="current-stack">
                <span>Blazor WebAssembly</span><span>.NET MAUI</span><span>REST APIs</span><span>Telerik UI</span><span>MudBlazor</span><span>GPS &amp; offline</span>
            </div>
        </div>

        <div class="current-work-card project-text-card">
            <div class="current-work-top">
                <span class="current-badge is-past">May 2021 &ndash; Jun 2023</span>
                <span class="current-companies">Provincial Government of Misamis Oriental &middot; Progressive Web App</span>
            </div>

            <h3 class="current-title">Electronic Leave Application System</h3>
            <p class="current-lead">
                Designed and deployed a digital leave application system that replaced manual, paper-based processes,
                with automated approval workflows, real-time tracking and employee training modules.
            </p>

            <div class="current-highlights">
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.InstallMobile" Class="current-highlight-icon" />
                    <h4>PWA features</h4>
                    <p>Fast and accessible on any device, with offline support so employees can draft applications without a connection.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Rule" Class="current-highlight-icon" />
                    <h4>Automated workflows</h4>
                    <p>Streamlined approvals from department heads to HR, cutting processing time and paper waste.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.School" Class="current-highlight-icon" />
                    <h4>Rollout &amp; training</h4>
                    <p>Maintained and enhanced the system after deployment and ran employee training sessions.</p>
                </div>
            </div>

            <div class="current-stack">
                <span>Blazor WebAssembly</span><span>PWA</span><span>Offline support</span><span>Approval workflows</span>
            </div>
        </div>

        <div class="current-work-card project-text-card">
            <div class="current-work-top">
                <span class="current-badge is-past">Jan 2020 &ndash; Dec 2020</span>
                <span class="current-companies">Department of Social Welfare and Development &middot; Full-stack .NET &amp; OCR</span>
            </div>

            <h3 class="current-title">Document Management System</h3>
            <p class="current-lead">
                Developed and enhanced a Document Management System for document tracking and storage, integrating OCR
                to digitize physical documents and make them searchable and accessible.
            </p>

            <div class="current-highlights">
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Class="current-highlight-icon" />
                    <h4>OCR digitization</h4>
                    <p>Automatic text extraction from scanned documents, enabling full-text search across thousands of records.</p>
                </div>
                <div class="current-highlight">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="current-highlight-icon" />
                    <h4>Efficient archiving</h4>
                    <p>Structured categorization and indexing that greatly improved document retrieval time for government staff.</p>
                </div>
            </div>

            <div class="current-stack">
                <span>.NET</span><span>OCR</span><span>Document management</span><span>Indexing &amp; search</span>
            </div>
        </div>
      @* <div class="d-flex justify-content-center mt-5"> *@
      @*       <MudButton Variant="Variant.Filled" Color="Color.Primary">View more</MudButton> *@
      @* </div> *@
    </div>
</section>
