@using System.Linq
<div class="contribution-dashboard">
    <div class="contribution-main">
        <div class="graph-header d-flex justify-space-between align-center px-4 pt-4">
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: var(--gh-text);">
                    @_totalContributions contributions in @_currentYear
                </MudText>
            </div>
            <div class="d-none d-md-block">
                 <MudText Typo="Typo.caption" Style="color: var(--gh-text-muted);">
                    Technical Commitment & Activity
                </MudText>
            </div>
        </div>

        <div class="contribution-graph-container">
            <div class="graph-scroll-wrapper">
                <div class="graph-grid">
                    @* Day labels on the left *@
                    <div class="graph-day-labels d-none d-md-flex">
                        <span>Mon</span>
                        <span>Wed</span>
                        <span>Fri</span>
                    </div>

                    @for (int week = 0; week < 52; week++)
                    {
                        <div class="graph-column">
                            @for (int day = 0; day < 7; day++)
                            {
                                var intensity = GetIntensityForYearAndDay(_currentYear, week, day);
                                <div class="graph-square level-@intensity" title="Activity on day @(day+1), week @(week+1): Level @intensity"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="graph-footer d-flex align-center justify-space-between mt-4 px-2">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.caption" Style="color: var(--gh-text-muted); font-size: 11px;">
                        Learn more about how we count contributions
                    </MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.caption" Style="font-size: 10px; color: var(--gh-text-muted);">Less</MudText>
                    <div class="graph-square level-0"></div>
                    <div class="graph-square level-1"></div>
                    <div class="graph-square level-2"></div>
                    <div class="graph-square level-3"></div>
                    <div class="graph-square level-4"></div>
                    <MudText Typo="Typo.caption" Style="font-size: 10px; color: var(--gh-text-muted);">More</MudText>
                </div>
            </div>
        </div>
    </div>

    @* Year Selector Sidebar *@
    <div class="year-selector">
        @foreach (var year in _availableYears)
        {
            <div class="year-item @(year == _currentYear ? "active" : "")">
                @year
            </div>
        }
    </div>
</div>

@code {
    private const int Weeks = 52;
    private const int TextTopRow = 1;

    private static readonly int ThisYear = DateTime.Today.Year;
    private int _currentYear = ThisYear;
    private List<int> _availableYears => Enumerable.Range(CareerInfo.CareerStart.Year, ThisYear - CareerInfo.CareerStart.Year + 1).Reverse().ToList();
    private int _totalContributions => CalculateTotalForYear(_currentYear);

    private bool[,] _pattern = new bool[Weeks, 7];

    // 5-row pixel font; '#' is a lit square.
    private static readonly Dictionary<char, string[]> Glyphs = new()
    {
        ['0'] = new[] { "#####", "#...#", "#...#", "#...#", "#####" },
        ['1'] = new[] { "..#..", ".##..", "..#..", "..#..", ".###." },
        ['2'] = new[] { "#####", "....#", "#####", "#....", "#####" },
        ['3'] = new[] { "#####", "....#", "#####", "....#", "#####" },
        ['4'] = new[] { "#...#", "#...#", "#####", "....#", "....#" },
        ['5'] = new[] { "#####", "#....", "#####", "....#", "#####" },
        ['6'] = new[] { "#####", "#....", "#####", "#...#", "#####" },
        ['7'] = new[] { "#####", "....#", "...#.", "..#..", "..#.." },
        ['8'] = new[] { "#####", "#...#", "#####", "#...#", "#####" },
        ['9'] = new[] { "#####", "#...#", "#####", "....#", "#####" },
        ['+'] = new[] { "..#..", "..#..", "#####", "..#..", "..#.." },
        ['Y'] = new[] { "#...#", "#...#", ".###.", "..#..", "..#.." },
        ['E'] = new[] { "####", "#...", "####", "#...", "####" },
        ['A'] = new[] { "#####", "#...#", "#####", "#...#", "#...#" },
        ['R'] = new[] { "#####", "#...#", "#####", "#.#..", "#...#" },
        ['S'] = new[] { "#####", "#....", "#####", "....#", "#####" },
    };

    protected override void OnInitialized()
    {
        _pattern = BuildPattern($"{CareerInfo.YearsOfExperience}+ YEARS");
    }

    private static bool[,] BuildPattern(string text)
    {
        var pattern = new bool[Weeks, 7];

        foreach (var gap in new[] { 2, 1 })
        {
            var width = MeasureText(text, gap);
            if (width > Weeks - 2 && gap > 1)
            {
                continue;
            }

            var x = Math.Max(0, (Weeks - width) / 2);
            foreach (var ch in text)
            {
                if (ch == ' ')
                {
                    x += gap;
                    continue;
                }

                var rows = Glyphs[ch];
                for (var row = 0; row < rows.Length; row++)
                {
                    for (var col = 0; col < rows[row].Length; col++)
                    {
                        if (rows[row][col] == '#' && x + col < Weeks)
                        {
                            pattern[x + col, TextTopRow + row] = true;
                        }
                    }
                }
                x += rows[0].Length + gap;
            }
            break;
        }

        return pattern;
    }

    private static int MeasureText(string text, int gap)
    {
        var width = 0;
        foreach (var ch in text)
        {
            width += ch == ' ' ? gap : Glyphs[ch][0].Length + gap;
        }
        return width - gap;
    }

    private int GetIntensityForYearAndDay(int year, int week, int day)
    {
        var isTextYear = year == ThisYear;
        if (isTextYear && _pattern[week, day])
        {
            return 4;
        }

        var seed = year * 1000 + week * 7 + day;
        var rnd = new Random(seed);
        int baseProb = rnd.Next(0, 100);
        int threshold = 40 - (year - CareerInfo.CareerStart.Year) * 2;

        int level;
        if (baseProb < threshold) level = 0;
        else if (baseProb < 70) level = 1;
        else if (baseProb < 85) level = 2;
        else if (baseProb < 95) level = 3;
        else level = 4;

        // Keep the background dim so the years text stays readable.
        return isTextYear ? Math.Min(level, 2) : level;
    }

    private int CalculateTotalForYear(int year)
    {
        return 1200 + (year - 2020) * 150 + (year % 3 * 42);
    }
}

<style>
    .contribution-dashboard {
        display: flex;
        gap: 20px;
        margin: 20px 0;
        padding-right: 12px;
        max-width: 100%;
        overflow-x: auto; /* Allow scrolling instead of clipping */
        -webkit-overflow-scrolling: touch;
    }

    .contribution-main {
        flex: 1;
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        overflow: hidden;
    }

    .contribution-graph-container {
        padding: 16px;
        position: relative;
    }

    .graph-scroll-wrapper {
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .graph-grid {
        display: grid;
        grid-template-columns: auto repeat(52, minmax(0, 1fr));
        gap: 3px;
        width: 100%;
        position: relative;
    }

    .graph-day-labels {
        flex-direction: column;
        justify-content: space-around;
        padding-right: 6px;
        font-size: 10px;
        color: var(--gh-text-muted);
    }

    .graph-column {
        display: grid;
        grid-template-rows: repeat(7, auto);
        gap: 3px;
    }

    .graph-square {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 2px;
        transition: transform 0.1s;
        cursor: pointer;
    }

    .graph-footer .graph-square {
        width: 10px;
        height: 10px;
    }

    .graph-square:hover {
        transform: scale(1.4);
        outline: 1px solid var(--gh-text);
        z-index: 10;
        box-shadow: 0 0 10px rgba(255,255,255,0.2);
    }

    .level-0 { background-color: var(--gh-green-0); }
    .level-1 { background-color: var(--gh-green-1); }
    .level-2 { background-color: var(--gh-green-2); }
    .level-3 { background-color: var(--gh-green-3); }
    .level-4 { background-color: var(--gh-green-4); }

    /* Year Selector */
    .year-selector {
        width: 80px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-top: 8px;
    }

    .year-item {
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        color: var(--gh-text);
        transition: 0.2s;
        text-align: left;
    }

    .year-item:hover {
        background-color: var(--gh-border);
    }

    .year-item.active {
        background-color: var(--gh-primary);
        color: white;
        font-weight: 600;
    }

    /* Custom Scrollbar */
    .graph-scroll-wrapper::-webkit-scrollbar {
        height: 6px;
    }
    .graph-scroll-wrapper::-webkit-scrollbar-track {
        background: transparent;
    }
    .graph-scroll-wrapper::-webkit-scrollbar-thumb {
        background: var(--gh-border);
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        .contribution-dashboard {
            flex-direction: column;
        }
        .year-selector {
            width: 100%;
            flex-direction: row;
            overflow-x: auto;
            padding-bottom: 8px;
        }
        .year-item {
            white-space: nowrap;
        }
    }
    @@media (max-width: 600px) {
        .graph-grid {
            gap: 2px;
        }
        .graph-column {
            gap: 2px;
        }
    }
</style>
