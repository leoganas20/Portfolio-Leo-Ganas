
@using Leo.Project.Portfolio.Web.Pages.EmailSender.Model
@using Leo.Project.Portfolio.Web.Services
@inject RequestEmailService RequestEmail
@inject ISnackbar Snackbar

<section id="contact" class="contact-section">
    <LoaderPage IsVisible="@IsVisible" />
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">// contact</span>
            <h2 class="section-title">Let's work together</h2>
            <p class="section-sub">Open to remote .NET roles and freelance projects. Reach out through any of these channels.</p>
        </div>

        <div class="contact-panel">
            <div class="contact-cta">
                <span class="contact-status"><span class="contact-status-dot"></span>Available for new opportunities</span>
                <h3 class="contact-cta-title">Hiring a .NET developer?</h3>
                <p class="contact-cta-text">
                    Send a short note about the role or project and I'll get back to you.
                </p>
                <div class="contact-cta-actions">
                    <a class="gh-btn-primary" href="mailto:leoganas.jr@gmail.com">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                        Email me
                    </a>
                    <a class="gh-btn-outline" href="Leonardo_Ganas_CV.pdf" download="Leonardo-Ganas-CV.pdf">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                        Download CV
                    </a>
                </div>
            </div>

            <div class="contact-grid">
                <a href="mailto:leoganas.jr@gmail.com" class="contact-tile">
                    <span class="contact-tile-icon" style="color: #EA4335;"><MudIcon Icon="@Icons.Material.Filled.Email" /></span>
                    <span class="contact-tile-label">Email</span>
                    <span class="contact-tile-value">leoganas.jr@gmail.com</span>
                </a>
                <a href="https://www.linkedin.com/in/leo-ganas-468b50212/" target="_blank" rel="noopener" class="contact-tile">
                    <span class="contact-tile-icon" style="color: #0A66C2;"><MudIcon Icon="@Icons.Custom.Brands.LinkedIn" /></span>
                    <span class="contact-tile-label">LinkedIn</span>
                    <span class="contact-tile-value">Leonardo L. Ganas Jr.</span>
                </a>
                <a href="https://wa.me/+639161452948" target="_blank" rel="noopener" class="contact-tile">
                    <span class="contact-tile-icon" style="color: #25D366;"><MudIcon Icon="@Icons.Custom.Brands.WhatsApp" /></span>
                    <span class="contact-tile-label">WhatsApp</span>
                    <span class="contact-tile-value">+63 916 145 2948</span>
                </a>
                <a href="https://www.upwork.com/freelancers/~016297b0547fe38cce" target="_blank" rel="noopener" class="contact-tile">
                    <span class="contact-tile-icon" style="color: #14A800;"><MudIcon Icon="@Icons.Material.Filled.Work" /></span>
                    <span class="contact-tile-label">Upwork</span>
                    <span class="contact-tile-value">Freelance profile</span>
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private bool IsVisible { get; set; } = false;
}

<style>
    .contact-section {
        padding: 80px 0 96px;
        background-color: var(--gh-bg);
        border-top: 1px solid var(--gh-border);
    }

    .contact-panel {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 40px;
        align-items: center;
        padding: 44px;
        background:
            radial-gradient(600px circle at 0% 100%, var(--gh-glow), transparent 60%),
            var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
    }

    .contact-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--gh-green-4);
        margin-bottom: 16px;
    }

    .contact-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--gh-green-4);
        box-shadow: 0 0 10px var(--gh-green-4);
    }

    .contact-cta-title {
        font-size: clamp(24px, 2.6vw, 30px);
        font-weight: 700;
        color: var(--gh-text);
        margin: 0 0 12px;
    }

    .contact-cta-text {
        font-size: 16px;
        line-height: 1.65;
        color: var(--gh-text-muted);
        margin: 0 0 28px;
    }

    .contact-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .contact-tile {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 20px;
        background: var(--gh-elevated);
        border: 1px solid var(--gh-border);
        border-radius: var(--radius-md);
        text-decoration: none !important;
        min-width: 0;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .contact-tile:hover {
        transform: translateY(-2px);
        border-color: var(--gh-border-strong);
    }

    .contact-tile-icon {
        display: inline-flex;
        margin-bottom: 10px;
    }

    .contact-tile-label {
        font-size: 13px;
        color: var(--gh-text-muted);
    }

    .contact-tile-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--gh-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 900px) {
        .contact-panel {
            grid-template-columns: 1fr;
            padding: 28px;
        }
    }

    @@media (max-width: 520px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
