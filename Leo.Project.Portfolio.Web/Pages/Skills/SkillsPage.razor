

<section id="skills" class="skills-section-v2">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">// skills</span>
            <h2 class="section-title">Technical expertise</h2>
            <p class="section-sub">The Microsoft stack I work in every day, plus the tools I reach for around it.</p>
        </div>

        <div class="skill-groups">
            @foreach (var group in SkillGroups)
            {
                <div class="skill-group">
                    <div class="skill-group-head">
                        <MudIcon Icon="@group.Icon" Class="skill-group-icon" />
                        <h3 class="skill-group-title">@group.Title</h3>
                    </div>
                    <div class="skill-chips">
                        @foreach (var skill in group.Skills)
                        {
                            <span class="skill-chip">@skill</span>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="skills-also">
            <span class="skills-also-label">Also:</span> Newtonsoft.Json, Unity 3D/2D, WebGL
        </p>
    </div>

    <div class="tech-marquee" aria-label="Tools and technologies I use">
        @for (var pass = 0; pass < 2; pass++)
        {
            <ul class="tech-track" aria-hidden="@(pass == 1 ? "true" : "false")">
                @foreach (var tech in TechLogos)
                {
                    <li class="tech-item">
                        <img src="images/tech/@(tech.File).svg" alt="@(pass == 0 ? tech.Name : "")" class="@(tech.DarkLogo ? "invert-on-dark" : "")" loading="lazy" />
                        <span>@tech.Name</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private record TechLogo(string Name, string File, bool DarkLogo = false);

    private readonly TechLogo[] TechLogos =
    {
        new("C#", "csharp"),
        new(".NET", "dot-net"),
        new("ASP.NET Core", "dotnetcore"),
        new("Blazor", "blazor"),
        new("Visual Studio", "visualstudio"),
        new("VS Code", "vscode"),
        new("Rider", "rider"),
        new("Claude Code", "claude"),
        new("Gemini", "googlegemini"),
        new("SQL Server", "microsoftsqlserver"),
        new("Azure SQL", "azuresqldatabase"),
        new("SQLite", "sqlite"),
        new("Azure", "azure"),
        new("Azure DevOps", "azuredevops"),
        new("NuGet", "nuget"),
        new("Swagger", "swagger"),
        new("Git", "git"),
        new("GitHub", "github", DarkLogo: true),
        new("Flutter", "flutter"),
        new("Dart", "dart"),
        new("HTML5", "html5"),
        new("CSS3", "css3"),
        new("JavaScript", "javascript"),
        new("Bootstrap", "bootstrap"),
        new("Figma", "figma"),
        new("Unity", "unity", DarkLogo: true),
    };

    private record SkillGroup(string Title, string Icon, string[] Skills);

    private readonly SkillGroup[] SkillGroups =
    {
        new("Core .NET & APIs", Icons.Material.Filled.Code,
            new[] { "C#", ".NET 9", ".NET 8", "ASP.NET Core", "ASP.NET MVC", "Web API", "Minimal APIs" }),
        new("Data", Icons.Material.Filled.Storage,
            new[] { "SQL Server", "Entity Framework", "SQLite" }),
        new("Front end", Icons.Material.Filled.Web,
            new[] { "Blazor WebAssembly", "Blazor Hybrid", "MudBlazor", "Telerik UI", "Kendo UI", "HTML / CSS", "JavaScript" }),
        new("Mobile", Icons.Material.Filled.Smartphone,
            new[] { ".NET MAUI", "Flutter / Dart", "Provider", "Go Router", "Dio" }),
        new("Cloud & DevOps", Icons.Material.Filled.Cloud,
            new[] { "Azure DevOps", "Azure Functions", "Entra ID", "CI/CD Pipelines", "OpenAPI / Swagger" }),
        new("Architecture & Quality", Icons.Material.Filled.AccountTree,
            new[] { "Clean Architecture", "CQRS", "DDD", "Unit Testing", "AutoMapper", "FluentValidation" }),
    };
}

<style>
    .skills-section-v2 {
        padding: 80px 0;
        background-color: var(--gh-bg);
        border-top: 1px solid var(--gh-border);
    }

    .skill-groups {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .skill-group {
        padding: 24px;
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .skill-group:hover {
        transform: translateY(-2px);
        border-color: var(--gh-border-strong);
    }

    .skill-group-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .skill-group .skill-group-icon {
        box-sizing: content-box;
        padding: 8px;
        border-radius: 10px;
        background: var(--gh-elevated);
        border: 1px solid var(--gh-border);
        color: var(--gh-green-4);
        font-size: 20px;
    }

    .skill-group-title {
        font-size: 17px;
        font-weight: 600;
        color: var(--gh-text);
        margin: 0;
    }

    .skill-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .skill-chip {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--gh-text);
        background: var(--gh-elevated);
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        padding: 5px 10px;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

    .skill-chip:hover {
        border-color: var(--gh-primary);
    }

    .skills-also {
        text-align: center;
        margin: 28px 0 0;
        font-size: 14px;
        color: var(--gh-text-muted);
    }

    .skills-also-label {
        font-family: var(--font-mono);
        color: var(--gh-green-4);
        margin-right: 6px;
    }

    .tech-marquee {
        display: flex;
        overflow: hidden;
        margin-top: 48px;
        padding: 6px 0;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    }

    .tech-track {
        display: flex;
        flex-shrink: 0;
        gap: 14px;
        padding: 0 7px 0 7px;
        margin: 0;
        list-style: none;
        animation: tech-scroll 45s linear infinite;
    }

    .tech-marquee:hover .tech-track {
        animation-play-state: paused;
    }

    .tech-item {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        padding: 10px 16px;
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gh-text);
        white-space: nowrap;
        transition: border-color 0.2s ease;
    }

    .tech-item:hover {
        border-color: var(--gh-border-strong);
    }

    .tech-item img {
        width: 26px;
        height: 26px;
        object-fit: contain;
    }

    [data-theme="dark"] .tech-item img.invert-on-dark {
        filter: invert(1);
    }

    @@keyframes tech-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-100%); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .tech-track {
            animation: none;
        }

        .tech-marquee {
            flex-wrap: wrap;
            justify-content: center;
            -webkit-mask-image: none;
            mask-image: none;
        }

        .tech-track[aria-hidden="true"] {
            display: none;
        }

        .tech-track {
            flex-wrap: wrap;
            justify-content: center;
        }
    }

    @@media (max-width: 992px) {
        .skill-groups {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .skill-groups {
            grid-template-columns: 1fr;
        }
    }
</style>
