@inject Leo.Project.Portfolio.Web.Services.ThemeService ThemeService
<section id="portfolio-gallery" class="experience-section">
    <div class="container">
        <div class="section-head">
            <span class="section-eyebrow">// experience</span>
            <h2 class="section-title">Where I've worked</h2>
            <p class="section-sub">Six years shipping .NET software, from government digital services to remote engineering teams in Malta.</p>
        </div>

        <ol class="timeline">
            @foreach (var job in Jobs)
            {
                <li class="timeline-item @(job.Current ? "is-current" : "")">
                    <div class="timeline-date">
                        <span>@job.Start</span>
                        <span class="timeline-date-end">@job.End</span>
                    </div>
                    <div class="timeline-rail"><span class="timeline-dot"></span></div>
                    <article class="timeline-card">
                        <header class="timeline-card-head">
                            <div>
                                <h3 class="timeline-company">@job.Company</h3>
                                <p class="timeline-role">@job.Role</p>
                                <p class="timeline-meta">@job.Meta</p>
                            </div>
                            <div class="timeline-logo @(job.SquareLogo ? "is-square" : "")">
                                <img src="@job.Logo" alt="@job.Company logo" loading="lazy" style="@LogoFilter(job)" />
                            </div>
                        </header>
                        <p class="timeline-desc">@job.Description</p>
                        <div class="timeline-tags">
                            @foreach (var tag in job.Tags)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    </article>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private enum LogoTint { None, OutlineAlways, OutlineLightOnly }

    private record Job(string Company, string Role, string Start, string End, string Meta, string Logo,
        bool SquareLogo, LogoTint Tint, string Description, string[] Tags, bool Current = false);

    private readonly Job[] Jobs =
    {
        new("KVLR Code", ".NET Software Engineer", "Dec 2025", "Present", "Enterprise software consultancy · Malta · Remote",
            "kvlr-logo.png", true, LogoTint.None,
            "Maintaining and refactoring a large, long-running legacy codebase for a licensing platform built on C# and .NET Core. Untangling and modernizing existing modules while preserving production behavior, with Entity Framework and SQL Server on the data layer.",
            new[] { "C#", ".NET Core", "Entity Framework", "SQL Server", "Legacy refactoring" }, Current: true),
        new("Born Digital", ".NET Software Engineer", "Dec 2025", "Present", "Digital engineering & product development · Malta · Remote",
            "born-digital-logo.png", true, LogoTint.None,
            "Working on the same licensing platform initiative, maintaining and refactoring a sizeable legacy codebase of ASP.NET Core Web APIs in C#. Reducing technical debt in existing services while shipping new functionality alongside the refactor.",
            new[] { "ASP.NET Core", "Web API", "C#", "Technical debt reduction" }, Current: true),
        new("Blackfort", "Full-Stack Blazor & MAUI Developer", "Jun 2023", "Dec 2025", "Software engineering & cloud solutions",
            "blackfort-logo-black.webp", false, LogoTint.OutlineAlways,
            "Key developer at Blackfort and primary developer of the native mobile app for infrastructure monitoring. Built web dashboards with real-time data tracking and offline support across platforms.",
            new[] { "Blazor WebAssembly", ".NET MAUI", "REST APIs", "Telerik UI", "MudBlazor" }),
        new("Provincial Gov. of Misamis Oriental", "Blazor WebAssembly Developer", "May 2021", "Jun 2023", "Public sector & governance",
            "provincial misamis.png", false, LogoTint.None,
            "Implemented the digital transformation of government services. Designed and deployed the Electronic Leave Application System and citizen-facing portals, and trained employees on the new tools.",
            new[] { "Blazor WebAssembly", "PWA", "Employee training" }),
        new("Dept. of Social Welfare & Development", ".NET Developer", "Jan 2020", "Dec 2020", "Social services · Government",
            "DSWD-Logo-700x394.png", false, LogoTint.None,
            "Developed and enhanced a Document Management System, including the OCR and indexing that lets staff retrieve and process citizen records quickly.",
            new[] { ".NET", "Document management", "OCR" }),
        new("Software Venture International", "Digitization Project Team Leader", "Jan 2020", "Aug 2020", "Corporate software services",
            "W-SVI Logos_SVI Corporation.avif", false, LogoTint.OutlineLightOnly,
            "Led the data capture workflow for large-scale OCR digitization projects and supervised the team, turning historical government records into secure digital assets.",
            new[] { "Team leadership", "OCR digitization", "Quality assurance" }),
    };

    private string LogoFilter(Job job)
    {
        const string white = "filter: drop-shadow(1px 1px 0 white) drop-shadow(-1px -1px 0 white) drop-shadow(1px -1px 0 white) drop-shadow(-1px 1px 0 white);";
        const string black = "filter: drop-shadow(1px 1px 0 black) drop-shadow(-1px -1px 0 black) drop-shadow(1px -1px 0 black) drop-shadow(-1px 1px 0 black);";
        return job.Tint switch
        {
            LogoTint.OutlineAlways => ThemeService.IsDarkMode ? white : black,
            LogoTint.OutlineLightOnly => ThemeService.IsDarkMode ? "" : black,
            _ => ""
        };
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}

<style>
    .experience-section {
        padding: 80px 0;
        background-color: var(--gh-bg);
        border-top: 1px solid var(--gh-border);
    }

    .timeline {
        list-style: none;
        max-width: 980px;
        margin: 0 auto;
        padding: 0;
    }

    .timeline-item {
        display: grid;
        grid-template-columns: 110px 32px 1fr;
        gap: 0 16px;
    }

    .timeline-date {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding-top: 26px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gh-text);
        line-height: 1.5;
    }

    .timeline-date-end {
        color: var(--gh-text-muted);
    }

    .timeline-rail {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .timeline-rail::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--gh-border);
    }

    .timeline-item:first-child .timeline-rail::before {
        top: 30px;
    }

    .timeline-item:last-child .timeline-rail::before {
        bottom: auto;
        height: 30px;
    }

    .timeline-dot {
        position: relative;
        margin-top: 26px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--gh-bg);
        border: 2px solid var(--gh-border-strong);
    }

    .timeline-item.is-current .timeline-dot {
        border-color: var(--gh-green-4);
        background: var(--gh-green-4);
        box-shadow: 0 0 0 4px var(--gh-glow), 0 0 12px var(--gh-green-4);
    }

    .timeline-card {
        margin-bottom: 20px;
        padding: 24px 26px;
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .timeline-card:hover {
        transform: translateY(-2px);
        border-color: var(--gh-border-strong);
    }

    .timeline-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 14px;
    }

    .timeline-company {
        font-size: 20px;
        font-weight: 700;
        color: var(--gh-text);
        margin: 0 0 4px;
    }

    .timeline-role {
        font-size: 15px;
        font-weight: 600;
        color: var(--gh-green-4);
        margin: 0 0 4px;
    }

    .timeline-meta {
        font-size: 13px;
        color: var(--gh-text-muted);
        margin: 0;
    }

    .timeline-logo {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 130px;
        height: 48px;
    }

    .timeline-logo img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .timeline-logo.is-square {
        width: 48px;
    }

    .timeline-logo.is-square img {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        object-fit: cover;
    }

    .timeline-desc {
        font-size: 15px;
        line-height: 1.65;
        color: var(--gh-text-muted);
        margin: 0 0 16px;
    }

    .timeline-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .timeline-tags span {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--gh-text);
        background: var(--gh-elevated);
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        padding: 4px 9px;
    }

    @@media (max-width: 768px) {
        .timeline-item {
            grid-template-columns: 20px 1fr;
            gap: 0 12px;
        }

        .timeline-date {
            grid-column: 2;
            grid-row: 1;
            flex-direction: row;
            gap: 6px;
            align-items: center;
            padding-top: 0;
            margin-bottom: 8px;
        }

        .timeline-date-end::before {
            content: '–';
            margin-right: 6px;
            color: var(--gh-text-muted);
        }

        .timeline-rail {
            grid-column: 1;
            grid-row: 1 / span 2;
        }

        .timeline-dot {
            margin-top: 4px;
        }

        .timeline-card {
            grid-column: 2;
            grid-row: 2;
        }

        .timeline-logo {
            display: none;
        }
    }
</style>
